{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "*.html",
        "*.css",
        "*.png",
        "*.ico",
        "*.js",
        "migrations/**"
      ],
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}