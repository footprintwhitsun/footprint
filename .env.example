# Server Configuration
PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/pos_db

# Security
# Generate each one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# A production server refuses to start with a short value or with the old published examples.
JWT_SECRET=
SESSION_SECRET=
# Comma-separated extra sites allowed to send cookie-authenticated writes (normally empty).
ALLOWED_ORIGINS=
# Database TLS: put your provider's CA certificate (PEM text, or a file path) here to verify the server.
DB_SSL_CA=
DB_SSL_REJECT_UNAUTHORIZED=false
CORS_ORIGIN=http://localhost:3000

# Email / SMTP Configuration (Required for Password Reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ADMIN_EMAIL=admin@okwesiwaltd.com

# Mobile Money (Optional)
MTN_MOMO_SUBSCRIPTION_KEY=your_subscription_key